# RPC (Helius first; QuickNode optional fallback)
HELIUS_RPC_URL=
HELIUS_RPC_URL_BETA=
HELIUS_RPC_URL_FAST=
QUICKNODE_RPC_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional client-side aliases (server reads SUPABASE_* above)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional
PORT=4077
# Optional — primary tracked mint (cron target). Also included in tracked list.
TOKEN_MINT=Hh3oTaqDCKKfdBgsQEvxp9sUwyNf8x9qmKqEMLBWpump
# Additional full-track mints (comma-separated). TOKEN_MINT is always tracked too.
TRACKED_MINTS=
MAX_DISPLAY_HOLDERS=500
REFRESH_SECRET=
CRON_SECRET=

# Lite coin cache + rate limits
LITE_MINT_TTL_MS=3600000
LITE_SCAN_LOCK_MS=300000
FREE_COLD_SCAN_LIMIT=8
FREE_WARM_READ_LIMIT=120
PRO_COLD_SCAN_LIMIT=60
PRO_WARM_READ_LIMIT=2000

# Pro API keys (comma-separated). Generate with: npm run generate:api-key
HODLSCAN_PRO_API_KEYS=

# Dune (pull saved query results via `npm run import:history:dune`)
DUNE_API_KEY=
