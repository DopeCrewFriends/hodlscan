{
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/refresh.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/coin/:mint",
      "destination": "/index.html"
    },
    {
      "source": "/wallet/:address",
      "destination": "/index.html"
    }
  ]
}
